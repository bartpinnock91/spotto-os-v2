{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "Bash(dir:*)",
      "Bash(cd:*)",
      "Bash(type:*)",
      "Bash(mkdir:*)",
      "Bash(del:*)",
      "Bash(move:*)",
      "Bash(copy:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git mv:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git pull:*)",
      "Bash(git push:*)",
      "Bash(gh api:*)",
      "Bash(powershell:*)",
      "Bash(python:*)",
      "Bash(python -m uvx:*)",
      "Bash(python -m uv tool run:*)",
      "Bash(claude mcp:*)",
      "mcp__atlassian__*",
      "mcp__figma__*",
      "mcp__azure-devops__*",
      "mcp__linear__*",
      "mcp__notion__*",
      "mcp__analytics-mcp__*",
      "mcp__google-search-console__*",
      "mcp__freshdesk__*"
    ]
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "atlassian",
    "figma",
    "azure-devops",
    "linear",
    "freshdesk"
  ]
}
